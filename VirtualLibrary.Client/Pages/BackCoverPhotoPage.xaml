<Page x:Class="VirtualLibrary.Client.Pages.BackCoverPhotoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="← Back" Click="OnBack" />
            <TextBlock Grid.Column="1" Text="Back Cover Photo" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

                <TextBlock x:Name="BookTitleText" Opacity="0.7" />

                <TextBlock TextWrapping="Wrap" Opacity="0.6"
                           Text="Hold the phone directly above the back cover on a flat surface. The rulers in the viewfinder provide a scale reference for the crop algorithm." />

                <Button x:Name="CaptureButton"
                        Content="Open Camera with Rulers"
                        Click="OnCapture"
                        HorizontalAlignment="Left" />

                <TextBlock x:Name="StatusText" Opacity="0.7" />

                <!-- Result after capture -->
                <StackPanel x:Name="PreviewPanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="Saved to device" FontWeight="SemiBold" />
                    <TextBlock x:Name="FilePathText" Opacity="0.5" TextWrapping="Wrap"
                               FontSize="12" />
                    <Image x:Name="PreviewImage" MaxHeight="400" Stretch="Uniform"
                           HorizontalAlignment="Left" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
